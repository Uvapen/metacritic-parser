# Скопируйте в .env: copy .env.example .env
# Ключ: https://console.groq.com/keys

DATABASE_URL=sqlite+aiosqlite:///./data/metacritic.db
DEBUG=false
HOST=0.0.0.0
PORT=8000

GROQ_API_KEY=
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=openai/gpt-oss-120b
# Если у модели суточный лимит (429 TPD/RPD) — берём следующую
LLM_FALLBACK_MODELS=openai/gpt-oss-20b
LLM_TIMEOUT=60.0
# Пауза между любыми вызовами Groq (chat + Whisper), секунды
LLM_CALL_INTERVAL=20.0

SCHEDULER_ENABLED=true
PIPELINE_INTERVAL_HOURS=1
GAMES_LIMIT=20
CARD_DELAY_SECONDS=1.5

YOUTUBE_ENABLED=true
YOUTUBE_TIMEOUT=25.0
YOUTUBE_CALL_INTERVAL=1.5
YOUTUBE_BACKFILL_LIMIT=40
YOUTUBE_SWEEP_LIMIT=10
ENRICHMENT_TICK_SECONDS=30

WHISPER_ENABLED=true
WHISPER_MODEL=whisper-large-v3-turbo
WHISPER_TIMEOUT=180.0
